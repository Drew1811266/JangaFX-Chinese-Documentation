      "note": "stage 3B translation"
    },
    {
      "id": "dd3dafca087b",
      "source": "Note that the Interpolation Color Space is also saved in the preset",
      "target": "请注意，Interpolation Color Space（插值颜色空间）也会保存在预设中",
      "note": "stage 3B translation"
    },
    {
      "id": "181d0b66798c",
