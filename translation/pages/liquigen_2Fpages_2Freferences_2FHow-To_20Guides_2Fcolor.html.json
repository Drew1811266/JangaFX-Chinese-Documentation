    {
      "id": "3f3122f4cabe",
      "source": "Toggle Light / Dark / Auto color theme",
      "target": "切换浅色/深色/自动颜色主题",
      "note": "translation memory"
    },
    {
      "id": "a18a44c77ae0",
      "source": "Toggle table of contents sidebar",
