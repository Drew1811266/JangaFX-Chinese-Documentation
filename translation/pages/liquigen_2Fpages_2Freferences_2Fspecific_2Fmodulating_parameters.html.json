      "target": "Position",
      "note": ""
    },
    {
      "id": "7f5403c60365",
      "source": " parameter to ",
      "target": " 参数的覆盖状态设置为 ",
      "note": ""
    },
    {
      "id": "d2fa580d59a8",
      "source": "Pin Override",
      "target": "Pin Override",
      "note": ""
    },
    {
      "id": "3e101601acf7",
      "source": " by ",
      "target": "，方法是 ",
      "note": ""
    },
    {
      "id": "fb46d5850338",
      "source": " clicking on the icon next to it.",
      "target": " 单击其旁边的图标。",
      "note": ""
    },
    {
      "id": "fbc023fd1e45",
      "source": "Connect an ",
      "target": "将 ",
      "note": ""
    },
    {
      "id": "d74c350cf945",
      "source": "Mod: Oscillator",
      "target": "Mod: Oscillator",
      "note": "translation memory"
    },
    {
      "id": "789dfa20665a",
      "source": " node to the now exposed pin on the left side.",
      "target": " 节点连接到左侧现在暴露出来的引脚。",
      "note": ""
    },
    {
      "id": "de40daf75f37",
      "source": "Set ",
      "target": "将 ",
      "note": ""
    },
