    },
    {
      "id": "8fec4db9ff37",
      "source": " axis.",
      "target": " 轴。",
      "note": ""
    },
    {
      "id": "911b95a7917f",
      "source": "When modulating a parameter with a single value the ",
      "target": "调制单值参数时，只会使用 ",
      "note": ""
    },
    {
      "id": "6a7de06ee79e",
      "source": " or ",
      "target": " 或 ",
