    },
    {
      "id": "6780478cc9c5",
      "source": " output is used only.",
      "target": " 输出。",
      "note": ""
    },
    {
      "id": "35667c5246f9",
      "source": "When modulating a color parameter ",
      "target": "调制颜色参数时，",
      "note": ""
    },
    {
      "id": "f861c287a554",
