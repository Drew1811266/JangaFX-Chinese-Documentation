    {
      "id": "430d17c29309",
      "source": "Invert Direction:",
      "target": "Invert Direction：",
      "note": ""
    },
    {
      "id": "caa9371f8ab3",
      "source": " Checking the Mouse-Y box will invert the controls for vertical orbiting the camera.",
      "target": " 勾选 Mouse-Y 复选框会反转摄像机垂直环绕控制。",
      "note": ""
    },
    {
      "id": "9ed92a7a28b7",
      "source": "Zoom Axis:",
      "target": "Zoom Axis：",
      "note": ""
    },
    {
      "id": "175da90233c9",
      "source": " Zoom moving your mouse either horizontally or vertically.",
      "target": " 通过水平或垂直移动鼠标进行缩放。",
      "note": ""
    },
    {
      "id": "a269e68a70bd",
      "source": "Invert Zoom Direction:",
      "target": "Invert Zoom Direction：",
      "note": ""
    },
    {
      "id": "5ce411e0af59",
      "source": " Invert the zoom controls for either the mouse or the scroll wheel.",
      "target": " 反转鼠标或滚轮的缩放控制。",
      "note": ""
    },
    {
      "id": "d70083dc58a9",
      "source": "Reset To Default:",
      "target": "Reset To Default：",
      "note": ""
    },
    {
      "id": "5d16cb58f688",
      "source": " Set all the controls in the ",
      "target": " 将 ",
      "note": ""
    },
    {
      "id": "1b7cbba238f7",
